# Example environment variables for Docker Compose
# Copy this to .env and customize as needed

# Python settings
PYTHONPATH=/app/src
PYTHONUNBUFFERED=1

# Logging
LOG_LEVEL=INFO
LOG_TO_CONSOLE=false

# Server settings (override config.toml)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Development settings
RELOAD=false

# UV settings
UV_CACHE_DIR=/tmp/uv-cache

# Timezone (for container)
TZ=UTC