# justfile for kindle-home-display-server
# Modern task runner - simpler and more powerful than make

# Show available recipes
default:
    @just --list

# Install dependencies and project in development mode
install:
    uv sync
    uv pip install -e .

# Python development tasks
# Run the server with optional arguments
server *args:
    uv run fastapi run src/server/main.py {{args}}

# Run the server in development mode with auto-reload
server-dev *args:
    uv run fastapi dev server/main.py {{args}}

# Generate dashboard image once  
generate:
    uv run python generate_image.py

# Alias for generate
image: generate

# Run tests with pytest
test:
    uv run pytest tests

# Run tests with coverage
test-cov:
    uv run coverage run -m pytest tests

# Generate coverage report
cov-report:
    uv run coverage report

# Generate HTML coverage report
cov-html:
    uv run coverage html

# Run tests with coverage and generate report
cov: test-cov cov-report

# Run type checking with mypy
types:
    uv run mypy src/server tests

# Run linting with ruff
lint:
    uv run ruff check src tests

# Run linting with ruff and fix issues
lint-fix:
    uv run ruff check --fix src tests

# Format code with ruff
format:
    uv run ruff format src tests

# Check code formatting
format-check:
    uv run ruff format --check src tests

# Run performance profiling
profile *args:
    PYTHONPATH=src uv run python -m cProfile -o program.prof -m server.main {{args}}
    uv run tuna program.prof

# Clean up generated files
clean:
    rm -rf .coverage
    rm -rf .mypy_cache
    rm -rf .pytest_cache
    rm -rf htmlcov/
    rm -rf build/
    rm -rf dist/
    rm -rf *.egg-info
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    find . -type f -name "*.pyc" -delete
    find . -type f -name "*.pyo" -delete
    rm -f program.prof

# Docker commands
# Build Docker image
docker-build:
    docker-compose build

# Start Docker services
docker-up:
    docker-compose up -d

# Start Docker services with build
docker-up-build:
    docker-compose up --build

# Stop Docker services
docker-down:
    docker-compose down

# View Docker logs
docker-logs:
    docker-compose logs -f server

# Start development server with hot reload
docker-dev:
    docker-compose --profile dev up server-dev

# Shell into running Docker container
docker-shell:
    docker-compose exec server bash

# Check Docker container health
docker-health:
    curl -f http://localhost:8000/health || echo "Health check failed"

# Development workflow recipes
# Run full quality checks
qa: lint types test

# Quick development cycle
dev: lint-fix format test

# Start development server (alias for server-dev)
serve: server-dev

# Prepare for commit
pre-commit: format lint types test cov-report

# Reset development environment
reset: clean
    rm -rf .venv
    uv sync
    uv pip install -e .